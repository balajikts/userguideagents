# --- LLM ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # only if LLM_PROVIDER=openai

# --- Retrieval ---
TAVILY_API_KEY=
CLARIFY_THRESHOLD=0.6
MAX_SOURCES=8

# --- Infra (docker-compose overrides DATABASE_URL / REDIS_URL for containers) ---
POSTGRES_USER=guide
POSTGRES_PASSWORD=change-me
POSTGRES_DB=guide
DATABASE_URL=postgresql://guide:change-me@localhost:5432/guide
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MIN=20

# --- Deployment ---
DOMAIN=guide.example.com
ACME_EMAIL=you@example.com

# --- Evals (LangSmith) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=electronics-guide
