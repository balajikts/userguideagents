# --- LLM: set ONE provider and its key ---
# LLM_PROVIDER: openai | anthropic
LLM_PROVIDER=openai
# Optional model override; defaults: openai -> gpt-5, anthropic -> claude-opus-5-5
# LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Retrieval ---
# Manual vector store: chroma (local default; embedded, no Postgres driver needed)
# or pgvector (docker-compose sets this for the api service).
VECTOR_STORE=chroma
CHROMA_PATH=./data/chroma
# Optional: without it, only manuals you ingest into the vector store are searched
TAVILY_API_KEY=
CLARIFY_THRESHOLD=0.6
MAX_SOURCES=8

# --- Infra (docker-compose overrides DATABASE_URL / REDIS_URL for containers) ---
POSTGRES_USER=guide
POSTGRES_PASSWORD=change-me
POSTGRES_DB=guide
DATABASE_URL=postgresql://guide:change-me@localhost:5432/guide
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MIN=20

# --- Deployment ---
DOMAIN=guide.example.com
ACME_EMAIL=you@example.com

# --- Evals (LangSmith) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=electronics-guide
